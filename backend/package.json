{
  "name": "@qrate/analytics-backend",
  "version": "1.0.0",
  "description": "This folder will contain Qrate's reusable Node.js and TypeScript analytics backend.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "market:inspect": "tsx src/market.ts inspect",
    "market:listen": "tsx src/market.ts listen",
    "market:recover": "tsx src/market.ts recover",
    "market:status": "tsx src/market.ts status",
    "listen": "tsx src/listen.ts",
    "listen:built": "node dist/listen.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "rpc:test": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/ws": "8.18.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "dotenv": "18.0.9",
    "ws": "8.22.0"
  }
}
